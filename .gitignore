# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# ...but desktop/build/ is SOURCE, not output: it holds the app icon and the
# macOS entitlements electron-builder reads. `build/` above matches a
# directory of that name at any depth, which silently excluded both.
!desktop/build/
!desktop/build/**

# What electron-builder emits.
desktop/release/

# The Electron build. A second build of the same source for a second runtime —
# it must live under desktop/ so Node's upward node_modules walk finds the
# Electron-ABI better-sqlite3 rather than the root Node-ABI one. See
# desktop/README.md.
desktop/dist/

# Screenshots from the harness. Diagnostic output, never a fixture —
# comparing them byte-for-byte across machines would fail on font rendering.
shots/
desktop/shots/

# Test / coverage
coverage/

# Local database and config (rebuildable cache — never committed)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Environment
.env
.env.local

# Editor
.vscode/
.idea/
*.swp

# macOS
.DS_Store
