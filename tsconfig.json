{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // Only the files that genuinely import `electron` are excluded — their types
  // live in desktop/node_modules, and including them here would make a fresh
  // `npm install && npm run typecheck` fail unless you also installed the
  // desktop deps. tsconfig.desktop.json builds those, and needs them honestly.
  //
  // Everything else under src/electron/ — the IPC contract, the runner — is
  // deliberately free of Electron imports so it stays type-checked here and
  // testable under plain vitest. That is what makes any of this coverable in
  // a repo with no mocks.
  "exclude": [
    "src/**/*.test.ts",
    "src/electron/main/index.ts",
    "src/electron/preload.cts",
    "src/electron/measure.bench.ts",
    "src/electron/worker/**"
  ]
}
